  "cats.n1": "Building controls",
  "cats.n2": "VPN and firewalls",
  "cats.n3": "Solar and power",
  "cats.n4": "Industrial 4G routers",
  "cats.n5": "Industrial controllers",
  "cats.replay": "▶ Replay",
  "hyp.colH": "We guessed",
  "hyp.colHow": "How we checked",
  "hyp.colFound": "What we found",
  "hyp.h1": "Shops unplugged their fridge controls after the attacks.",
  "hyp.how1": "Daily counts of Danfoss, Copeland and Carel controls reachable online in Europe (Shadowserver), 11 Oct vs 11 Nov.",
  "hyp.found1": "5,985 → 2,550 (−57%).",
  "hyp.v1": "Yes",
  "hyp.h2": "Some countries reacted much more than others.",
  "hyp.how2": "The same counts, country by country.",
