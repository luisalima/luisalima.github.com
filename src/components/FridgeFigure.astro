}/*END*/;
window.FIG_LABELS = window.FIG_LABELS || {};
const L = (k) => (window.FIG_LABELS[k] != null ? window.FIG_LABELS[k] : LBL[k]) ?? k;
const applyLabels = () => document.querySelectorAll("[data-l]").forEach((e) => { e.textContent = L(e.dataset.l); });
const FIGS = window.FIGS = {};

/* 1 · tile map */
FIGS.map = () => {
  const svg = document.getElementById("map"); if (!svg) return; svg.innerHTML = ""; clearInterval(window.__mapTimer);
  const T = { NO:[4,0], SE:[5,0], FI:[6,0], DK:[4,1], EE:[7,1], IE:[1,2], UK:[2,2], NL:[3,2], DE:[4,2], PL:[5,2], LV:[7,2], BE:[3,3], LU:[4,3], CZ:[5,3], LT:[7,3], FR:[3,4], CH:[4,4], AT:[5,4], HU:[6,4], PT:[1,5], ES:[2,5], IT:[4,5], SI:[5,5], HR:[6,5] };
  const HIT = { FR:11, BE:32, EE:32, FI:32, IE:32, IT:32, LU:32, NL:32, SE:32, UK:32, DE:34 };
  const EV = [[0, "map.ev0"], [11, "map.ev1"], [32, "map.ev2"], [34, "map.ev3"], [39, "map.ev4"]];
  const S = 62, ox = 60, oy = 14, tiles = {};
  for (const [k, [c, r]] of Object.entries(T)) {
    const g = el("g", { transform: `translate(${ox + c * S},${oy + r * S})` }, svg);
    const rect = el("rect", { width: S - 6, height: S - 6, rx: 6, fill: "#14202e", stroke: "#25384d", style: "transition:fill .6s,stroke .6s" }, g);
    const fill = el("rect", { x: 6, y: S - 14, width: 10, height: 4, rx: 2, fill: COLD, style: "transition:width .6s,fill .6s" }, g);
    const lab = tx(g, (S - 6) / 2, (S - 6) / 2 + 2, k, { anchor: "middle", w: 700, size: 13, fill: "#9fb4c8" });
    el("title", {}, g).textContent = HIT[k] != null ? `${k}: reported hit` : `${k}: none reported`;
    tiles[k] = { rect, fill, lab };
  }
  const drop = el("path", { d: "M0,-11 C6,-3 8,1 8,4 A8,8 0 0 1 -8,4 C-8,1 -6,-3 0,-11Z", fill: HOT, opacity: 0, transform: `translate(${ox + 3 * S + 46},${oy + 4 * S + 14})`, style: "transition:opacity .5s" }, svg);
  tx(svg, 630, 392, L("map.note"), { anchor: "end", size: 10, fill: MUTED });
  const r = document.getElementById("mapT"), d = document.getElementById("mapD"), cap = document.getElementById("mapCap");
  const fmt = (i) => { const dt = new Date(Date.UTC(2026, 9, 1 + i)); return dt.getUTCDate() + " " + (dt.getUTCMonth() === 9 ? "Oct" : "Nov"); };
  const show = (i) => {
    d.textContent = fmt(i);
    for (const [k, t] of Object.entries(tiles)) {
      const hit = HIT[k] != null && i >= HIT[k];
      t.rect.setAttribute("fill", hit ? "#4a1a17" : "#14202e"); t.rect.setAttribute("stroke", hit ? HOT : "#25384d");
      t.fill.setAttribute("fill", hit ? HOT : COLD); t.fill.setAttribute("width", hit ? S - 18 : 10);
      t.lab.setAttribute("fill", hit ? "#ffd9d5" : "#9fb4c8");
    }
    drop.setAttribute("opacity", i >= 34 ? 1 : 0);
    cap.textContent = L(EV.filter((e) => e[0] <= i).pop()[1]);
  };
  const stop = () => { clearInterval(window.__mapTimer); };
  r.oninput = () => { stop(); show(+r.value); };
  const play = () => { stop(); let i = +r.value >= 40 ? 0 : +r.value; window.__mapTimer = setInterval(() => { r.value = i; show(i); if (++i > 40) stop(); }, 180); };
  document.getElementById("mapPlay").onclick = play;
  if (RM) { r.value = 40; show(40); } else if (window.__mapSeen) show(+r.value); else { show(0); onSee(svg, () => { window.__mapSeen = 1; play(); }); }
};

/* 2 · thermometer */
FIGS.temp = () => {
  const svg = document.getElementById("temp"); if (!svg) return; svg.innerHTML = "";
  const N = document.getElementById("tempN"), T = document.getElementById("tempT");
  const x0 = 44, x1 = 620, y = (v) => 210 - v / 60 * 190, xs = (m) => x0 + m / 360 * (x1 - x0);
  [0, 20, 40, 60].forEach((v) => { el("line", { x1: x0, x2: x1, y1: y(v), y2: y(v), stroke: LINE }, svg); tx(svg, x0 - 8, y(v) + 4, v + "°", { anchor: "end", size: 11, fill: MUTED }); });
  el("rect", { x: x0, y: y(5), width: x1 - x0, height: y(0) - y(5), fill: COLD, opacity: .18 }, svg);
  tx(svg, x1, y(5) - 6, L("temp.safe"), { anchor: "end", size: 11, fill: COLD });
  const pts = []; for (let m = 0; m <= 360; m += 4) { const v = m < 40 ? 3 + Math.sin(m / 6) * .3 : 3 + 49 * (1 - Math.exp(-(m - 40) / 70)); pts.push([m, v]); }
  const d = pts.map(([m, v], i) => (i ? "L" : "M") + xs(m).toFixed(1) + "," + y(v).toFixed(1)).join("");
  const path = el("path", { d, fill: "none", stroke: HOT, "stroke-width": 3, "stroke-linecap": "round" }, svg);
  const len = path.getTotalLength(); path.style.strokeDasharray = len; path.style.strokeDashoffset = len;
  const mark = el("g", { opacity: 0 }, svg); el("line", { x1: xs(40), x2: xs(40), y1: y(60), y2: y(0), stroke: HOT, "stroke-dasharray": "3 4" }, mark); tx(mark, xs(40) + 6, y(56), L("temp.changed"), { size: 11, fill: HOT });
  ["02:00", "03:00", "04:00", "05:00", "06:00", "07:00", "08:00"].forEach((s, i) => tx(svg, xs(i * 60), 230, s, { anchor: "middle", size: 10, fill: MUTED }));
  tx(svg, x1, 14, L("temp.illus"), { anchor: "end", size: 10, fill: MUTED });
  const run = () => {
    cancelAnimationFrame(window.__tempRaf); const t0 = performance.now(), D = RM ? 1 : 5000;
    const step = (now) => { const p = Math.min(1, (now - t0) / D), m = p * 360, v = pts[Math.min(pts.length - 1, Math.round(m / 4))][1];
      path.style.strokeDashoffset = len * (1 - p); mark.setAttribute("opacity", m >= 40 ? 1 : 0);
      N.textContent = Math.round(v) + " °C"; N.style.color = v > 5 ? HOT : COLD;
      const hh = 2 + Math.floor(m / 60), mm = Math.floor(m % 60); T.textContent = `${String(Math.min(hh, 8)).padStart(2, "0")}:${String(hh >= 8 ? 0 : mm).padStart(2, "0")} · ${v > 5 ? L("temp.unsafe") : L("temp.normal")}`;
      if (p < 1) window.__tempRaf = requestAnimationFrame(step); };
    window.__tempRaf = requestAnimationFrame(step);
  };
  document.getElementById("tempPlay").onclick = run;
  if (window.__tempSeen) run(); else onSee(svg, () => { window.__tempSeen = 1; run(); });
};

/* 3 · guess on log scale */
FIGS.guess = () => {
  const svg = document.getElementById("guess"); if (!svg) return; svg.innerHTML = "";
  const inp = document.getElementById("gIn"), out = document.getElementById("gV"), cap = document.getElementById("gCap"), go = document.getElementById("gGo");
  const x0 = 30, x1 = 610, X = (lg) => x0 + (lg - 1) / 5 * (x1 - x0), ANS = 5985;
  el("line", { x1: x0, x2: x1, y1: 90, y2: 90, stroke: MUTED }, svg);
  [10, 100, 1000, 10000, 100000, 1000000].forEach((v) => { el("line", { x1: X(Math.log10(v)), x2: X(Math.log10(v)), y1: 84, y2: 96, stroke: MUTED }, svg); tx(svg, X(Math.log10(v)), 116, v.toLocaleString("en"), { anchor: "middle", size: 10.5, fill: MUTED }); });
  const g = el("g", {}, svg); el("line", { x1: 0, x2: 0, y1: 40, y2: 90, stroke: COLD, "stroke-width": 2, "stroke-dasharray": "4 3" }, g); el("circle", { cx: 0, cy: 90, r: 7, fill: COLD }, g); const gl = tx(g, 0, 32, "", { anchor: "middle", size: 12, fill: COLD, w: 700 });
  const a = el("g", { opacity: 0, style: "transition:opacity .6s" }, svg); el("circle", { cx: X(Math.log10(ANS)), cy: 90, r: 9, fill: HOT }, a); tx(a, X(Math.log10(ANS)), 70, ANS.toLocaleString("en"), { anchor: "middle", size: 18, fill: HOT, w: 700 });
  const fmt = (n) => n >= 1000 ? Math.round(n / 100) * 100 : Math.round(n);
  const upd = () => { const v = 10 ** +inp.value; out.textContent = fmt(v).toLocaleString("en"); g.setAttribute("transform", `translate(${X(+inp.value)},0)`); gl.textContent = L("guess.you") + " " + fmt(v).toLocaleString("en"); };
  const reveal = () => { go.disabled = true; inp.disabled = true; a.setAttribute("opacity", 1);
    const ratio = ANS / (10 ** +inp.value), n = ratio >= 10 ? Math.round(ratio) : ratio.toFixed(1);
    cap.textContent = (ratio > 1.5 ? L("guess.more").replace("{n}", n) : ratio < .67 ? L("guess.fewer") : L("guess.close")) + " " + L("guess.answer"); };
  inp.oninput = upd; upd(); go.onclick = reveal; if (go.disabled) reveal();
};

/* 4 · unit chart on canvas */
FIGS.dots = () => {
  const cv = document.getElementById("dots"); if (!cv) return;
  const cx = cv.getContext("2d"), W = cv.width, H = cv.height, N = 5985, cap = document.getElementById("dotCap");
  const C = [["France", 1865, 436], ["Italy", 803, 539], ["Romania", 586, 49], ["Poland", 505, 154], ["Belgium", 337, 48], ["Greece", 250, 151], ["Netherlands", 182, 73], ["Spain", 166, 162], ["Germany", 144, 103], ["others", 1147, 835]]; // Shadowserver, 11 Oct vs 2026-11-11
  console.assert(C.reduce((s, c) => s + c[1], 0) === N, "split must sum to N");
  const P = []; let seed = 7; const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
  const colW = (W - 80) / C.length, per = Math.floor((colW - 14) / 6);
  C.forEach(([k, n, now], ci) => { for (let j = 0; j < n; j++) {
    const row = Math.floor(j / per), col = j % per;
    P.push({ x0: rnd() * (W - 6), y0: rnd() * (H - 60) + 10, x1: 40 + ci * colW + col * 6, y1: H - 56 - row * 6, off: j >= now });
  } });
  const st = window.__dots = window.__dots || { state: 0, from: 0, t0: 0, raf: 0 };
