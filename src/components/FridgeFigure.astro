---
// GENERATED by data-experiments/2026-11-10-eu-perimeter/figures/build_component.py. Edit the gallery, then rebuild.
interface Props { part: "map" | "temp" | "guess" | "dots" | "sep" | "race" | "cats" | "hyp"; title: string; note?: string }
const { part, title, note } = Astro.props;
---
<figure class="fa">
  <p class="fa-t">{title}</p>
  {part === "map" && <Fragment set:html={'<div class="stage"><svg id="map" viewBox="0 0 640 400" role="img" aria-label="Tile map of Europe, countries turn red as attacks are reported"></svg>\n    <div class="ctl"><button id="mapPlay" data-l="map.play">▶ Play</button><input id="mapT" type="range" min="0" max="40" value="0" aria-label="Date"><span id="mapD" style="min-width:5.5em;font-weight:700">1 Oct</span></div>\n    <div class="cap" id="mapCap"></div></div>'} />}
  {part === "temp" && <Fragment set:html={'<div class="stage"><div style="display:flex;justify-content:space-between;align-items:flex-end;gap:12px;flex-wrap:wrap"><div class="big" id="tempN" style="color:#3b9eff">3 °C</div><div id="tempT" style="font-size:13px;color:#8b96a3;text-align:right">02:00 · normal</div></div>\n    <svg id="temp" viewBox="0 0 640 240" role="img" aria-label="Temperature line rising from 3 to over 50 degrees"></svg>\n    <div class="ctl"><button id="tempPlay" data-l="temp.replay">▶ Replay</button></div></div>'} />}
  {part === "guess" && <Fragment set:html={'<div class="stage"><svg id="guess" viewBox="0 0 640 150" role="img" aria-label="Log scale guess"></svg>\n    <div class="ctl"><input id="gIn" type="range" min="1" max="6" step="0.01" value="2" aria-label="Your guess"><span id="gV" style="min-width:6em;font-weight:700;color:#3b9eff">100</span><button id="gGo" data-l="guess.reveal">Reveal</button></div>\n    <div class="cap" id="gCap"></div></div>'} />}
  {part === "dots" && <Fragment set:html={'<div class="stage"><canvas id="dots" width="1280" height="800" aria-label="Unit chart of exposed controls"></canvas>\n    <div class="ctl"><button class="ghost" data-s="0" aria-pressed="true" data-l="dots.btn0">All of them</button><button class="ghost" data-s="1" data-l="dots.btn1">By country</button><button class="ghost" data-s="2" data-l="dots.btn2">Today</button></div>\n    <div class="cap" id="dotCap"></div></div>'} />}
  {part === "sep" && <Fragment set:html={'<div class="stage"><svg id="sep" viewBox="0 0 640 300" role="img" aria-label="Diagram: monitoring vs control access"></svg>\n    <div class="ctl"><button id="sepA" aria-pressed="true" data-l="sep.btnA">How it was</button><button id="sepB" data-l="sep.btnB">Separated</button></div>\n    <div class="cap" id="sepCap"></div></div>'} />}
  {part === "race" && <Fragment set:html={'<div class="stage"><svg id="race" viewBox="0 0 640 300" role="img" aria-label="Lines falling after the attacks"></svg>\n    <div class="ctl"><button id="racePlay" data-l="race.replay">▶ Replay</button></div></div>'} />}
  {part === "cats" && <Fragment set:html={'<div class="stage"><svg id="cats" viewBox="0 0 640 330" role="img" aria-label="Six small line charts; only fridge controls drop"></svg>\n    <div class="ctl"><button id="catsPlay" data-l="cats.replay">▶ Replay</button></div></div>'} />}
  {part === "hyp" && <Fragment set:html={'<div class="stage"><div class="hyp" id="hyp"></div></div>'} />}
  {note && <figcaption class="fa-n" set:html={note} />}
</figure>

<style is:global>
figure.fa{margin:32px 0;font-family:"Google Sans Code",ui-monospace,monospace}
figure.fa .fa-t{font-weight:700;font-size:18px;line-height:1.3;margin:0 0 10px;color:var(--foreground)}
figure.fa .fa-n{font-size:12.5px;color:var(--foreground);opacity:.7;margin-top:8px;line-height:1.5}
figure.fa .fa-n a{color:inherit}
figure.fa .stage p,figure.fa .stage div{color:#e8edf2}
figure.fa .stage a{color:#e8edf2}
figure.fa .stage{margin:0;background:#0d1117;color:#e8edf2;border-radius:12px;padding:18px;position:relative;overflow:hidden;
  background-image:radial-gradient(#1f2630 1px,transparent 1px);background-size:14px 14px}
figure.fa .stage .hyp table{width:100%;border-collapse:collapse;font-size:13px;line-height:1.45}
figure.fa .stage .hyp th{text-align:left;color:#8b96a3;font-weight:400;font-size:11.5px;padding:0 10px 8px 0;border-bottom:1px solid #1f2630}
figure.fa .stage .hyp td{vertical-align:top;padding:10px 10px 10px 0;border-bottom:1px solid #1f2630;color:#e8edf2}
figure.fa .stage .hyp td:nth-child(2){color:#aab4bf}
figure.fa .stage .hyp .v{display:inline-block;margin-top:4px;padding:1px 8px;border-radius:9px;font-size:11.5px;font-weight:700;white-space:nowrap}
figure.fa .stage .hyp .v-y{background:#4a1a17;color:#ff6b5e}
figure.fa .stage .hyp .v-n{background:#14202e;color:#9fb4c8}
figure.fa .stage .hyp .v-s{background:#14202e;color:#3b9eff}
figure.fa .stage .hyp .v-t{background:#1f2630;color:#8b96a3}
figure.fa .stage .hyp .hf{font-size:12px;color:#8b96a3;margin:10px 0 0}
figure.fa .stage .hyp.narrow thead{display:none}
figure.fa .stage .hyp.narrow tr,figure.fa .stage .hyp.narrow td{display:block}
figure.fa .stage .hyp.narrow tr{border-bottom:1px solid #1f2630;padding:8px 0}
figure.fa .stage .hyp.narrow td{border:0;padding:3px 0}
figure.fa .stage .hyp.narrow td:not(:first-child)::before{content:attr(data-c);display:block;color:#8b96a3;font-size:11px}
figure.fa .stage svg{display:block;width:100%;height:auto}
figure.fa .stage canvas{display:block;width:100%;height:auto}
figure.fa .ctl{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:10px}
figure.fa .ctl button{font:inherit;font-size:13px;font-weight:700;padding:6px 12px;border-radius:6px;border:0;background:#e8edf2;color:#0d1117;cursor:pointer}
figure.fa .ctl button[disabled]{opacity:.4;cursor:default}
figure.fa .ctl button.ghost{background:transparent;color:#e8edf2;border:1px solid #3a4451}
figure.fa .ctl button[aria-pressed="true"]{background:#3b9eff;color:#0d1117;border-color:#3b9eff}
figure.fa .ctl input[type=range]{flex:1;min-width:160px;accent-color:#ff6b5e}
figure.fa .cap{font-size:13.5px;color:#e8edf2;min-height:3em;margin-top:8px}
figure.fa .big{font-size:clamp(44px,9vw,84px);font-weight:700;line-height:1;letter-spacing:-.02em}
</style>

<script>

const NS = "http://www.w3.org/2000/svg", COLD = "#3b9eff", HOT = "#ff6b5e", OK = "#2fd36b", INK = "#e8edf2", MUTED = "#8b96a3", LINE = "#1f2630";
const RM = matchMedia("(prefers-reduced-motion: reduce)").matches;
const el = (tag, at = {}, parent) => { const e = document.createElementNS(NS, tag); for (const k in at) e.setAttribute(k, at[k]); if (parent) parent.appendChild(e); return e; };
const tx = (p, x, y, s, o = {}) => { const e = el("text", { x, y, fill: o.fill || INK, "font-size": o.size || 12, "text-anchor": o.anchor || "start", "font-weight": o.w || 400, "font-family": "ui-monospace,monospace" }, p); e.textContent = s; return e; };
const onSee = (node, fn) => new IntersectionObserver((es, ob) => { if (es[0].isIntersecting) { ob.disconnect(); fn(); } }, { threshold: .35 }).observe(node);

/* Every word a reader sees inside the figures. Edit here (or on the write-in-place page). */
const LBL = /*LABELS*/{
  "map.ev0": "1 Oct. Shops across Europe keep food cold with controls that technicians can reach remotely.",
