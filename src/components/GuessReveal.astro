---
// Guess first, then reveal (NYT Upshot style). Reusable: the post passes the question and the answers.
// The reader drags a slider, presses Reveal, and the bars grow; their guess stays as a line across them.
// An answer with `value: null` shows only its `text` (e.g. a measured time that isn't a share).
interface Answer { label: string; value: number | null; text?: string; source?: string; href?: string; kind?: "you" | "survey" | "now" }
interface Props { id: string; question: string; unit?: string; start?: number; answers: Answer[]; note?: string }
const { id, question, unit = "%", start = 30, answers, note } = Astro.props;
const data = JSON.stringify({ unit, answers });
---
<figure class="gr" id={id} data-gr={data}>
  <p class="gr-q">{question}</p>
  <div class="gr-in">
    <input type="range" min="0" max="100" step="5" value={start} aria-label="Your guess" />
    <output class="gr-v">{start}{unit}</output>
  </div>
  <button type="button" class="gr-b">Reveal</button>
  <div class="gr-bars" aria-live="polite"></div>
  {note && <figcaption class="gr-n" set:html={note} />}
</figure>
<style is:global>
figure.gr{--bg:#0d1117;--ink:#e8edf2;--muted:#8b96a3;--line:#1f2630;--you:#3b9eff;--survey:#9d8cff;--now:#2fd36b;
  background:var(--bg);color:var(--ink);border-radius:12px;padding:22px 22px 18px;margin:28px 0;
  font-family:"Google Sans Code",ui-monospace,monospace;background-image:radial-gradient(var(--line) 1px,transparent 1px);background-size:14px 14px}
figure.gr .gr-q{font-size:20px;font-weight:700;line-height:1.3;margin:0 0 18px}
figure.gr .gr-in{display:flex;align-items:center;gap:14px}
figure.gr .gr-in input{flex:1;accent-color:var(--you);height:28px}
figure.gr .gr-v{font-size:26px;font-weight:700;color:var(--you);min-width:3.2em;text-align:right}
figure.gr .gr-b{margin-top:12px;background:var(--ink);color:var(--bg);border:0;border-radius:6px;padding:8px 16px;font:inherit;font-weight:700;cursor:pointer}
figure.gr .gr-b[disabled]{opacity:.35;cursor:default}
figure.gr .gr-bars{position:relative;margin-top:6px}
figure.gr .gr-row{display:grid;grid-template-columns:minmax(120px,32%) 1fr;gap:12px;align-items:center;margin-top:14px;opacity:0;transform:translateY(6px);transition:opacity .5s,transform .5s}
figure.gr .gr-row.on{opacity:1;transform:none}
figure.gr .gr-l{font-size:13.5px;line-height:1.35}figure.gr .gr-l small{display:block;color:var(--muted);font-size:11.5px}
figure.gr .gr-l a{color:inherit}
figure.gr .gr-track{position:relative;height:26px}
figure.gr .gr-bar{position:absolute;left:0;top:3px;height:20px;width:0;border-radius:3px;transition:width 1.1s cubic-bezier(.2,.7,.2,1)}
figure.gr .gr-num{position:absolute;top:3px;font-size:13px;font-weight:700;line-height:20px;white-space:nowrap;transition:left 1.1s cubic-bezier(.2,.7,.2,1)}
figure.gr .gr-guess{position:absolute;top:0;bottom:0;width:0;border-left:2px dashed var(--you);opacity:.9}
figure.gr .gr-guess span{position:absolute;top:-18px;left:4px;font-size:11px;color:var(--you);white-space:nowrap}
figure.gr .gr-n{color:var(--muted);font-size:12px;line-height:1.5;margin-top:16px}
@media (max-width:560px){figure.gr .gr-row{grid-template-columns:1fr;gap:4px}figure.gr .gr-q{font-size:18px}}
@media (prefers-reduced-motion:reduce){figure.gr .gr-row,figure.gr .gr-bar,figure.gr .gr-num{transition:none}}
figure.gr p,figure.gr .gr-l{color:var(--ink);margin:0}
figure.gr p.gr-q{margin:0 0 18px}
figure.gr a{color:var(--ink);text-decoration:underline;text-decoration-color:var(--muted)}
figure.gr .gr-l small{color:var(--muted)}

figure.gr .gr-num.gr-txt{white-space:normal;right:0;line-height:1.3;top:2px}
figure.gr .gr-track:has(.gr-txt){height:auto;min-height:26px;padding:2px 0}
figure.gr .gr-track:has(.gr-txt) .gr-num{position:relative;display:block;padding-left:16px;left:0!important}
</style>
<script>
  for (const f of document.querySelectorAll<HTMLElement>("figure.gr")) {
    const { unit, answers } = JSON.parse(f.dataset.gr!);
    const r = f.querySelector("input")!, v = f.querySelector("output")!, b = f.querySelector("button")!, bars = f.querySelector(".gr-bars")!;
    r.addEventListener("input", () => (v.textContent = r.value + unit));
    b.addEventListener("click", () => {
      const g = +r.value; r.disabled = true; b.disabled = true; bars.innerHTML = "";
      answers.forEach((a: any, i: number) => {
        const row = document.createElement("div"); row.className = "gr-row";
        const lab = document.createElement("div"); lab.className = "gr-l";
        const sub = [a.value != null ? a.text : "", a.source].filter(Boolean).join(" · ");
        lab.innerHTML = (a.href ? `<a href="${a.href}">${a.label}</a>` : a.label) + (sub ? `<small>${sub}</small>` : "");
        const tr = document.createElement("div"); tr.className = "gr-track";
        const bar = document.createElement("div"); bar.className = "gr-bar"; bar.style.background = `var(--${a.kind || "survey"})`;
        const num = document.createElement("div"); num.className = "gr-num"; num.style.left = "0";
        num.textContent = a.value == null ? (a.text || "") : `${a.value}${unit}`;
        if (a.value == null) num.classList.add("gr-txt");
        const inside = a.value != null && a.value > 82;
        num.style.color = `var(--${a.kind || "survey"})`;
        const gl = document.createElement("div"); gl.className = "gr-guess"; gl.style.left = `${g}%`;
        if (i === 0) gl.innerHTML = `<span>your guess ${g}${unit}</span>`;
        tr.append(bar, num, gl); row.append(lab, tr); bars.append(row);
        setTimeout(() => {
          row.classList.add("on");
          if (inside) { bar.style.width = `${a.value}%`; num.style.left = `calc(${a.value}% - 48px)`; num.style.color = "var(--bg)"; }
          else if (a.value != null) { bar.style.width = `${a.value}%`; num.style.left = `calc(${a.value}% + 8px)`; }
          else { bar.style.width = "6px"; num.style.left = "16px"; }
        }, 250 + i * 450);
      });
    });
  }
</script>
