OM[0]))) * (W - ML - MR);\nconst med = (a) => { const s = [...a].sort((x, y) => x - y), m = s.length / 2; return s.length % 2 ? s[m | 0] : (s[m - 1] + s[m]) / 2; };\nconst dur = (h) => { const a = Math.abs(h); return a < 48 ? `${Math.round(a)} hours` : `${Math.round(a / 24)} days`; };\n\n// ---- derived facts (captions are filled from these, never typed by hand) ----\nconst loud = BUGS.filter((b) => b.set === \"loud\"), quiet = BUGS.filter((b) => b.set === \"quiet\");\nconst first = (b, ks) => Math.min(...b.ev.filter((e) => ks.includes(e.k)).map((e) => e.h));\nconst ev = (b, k) => b.ev.find((e) => e.k === k);\nconst acr = loud.find((b) => b.who === \"Acronis\");\nconst nBefore = loud.filter((b) => Math.min(...b.ev.map((e) => e.h)) < 0).length;\nconst pocs = loud.filter((b) => ev(b, \"poc\")).map((b) => { const m = first(b, [\"x\", \"reddit\", \"news\"]); return { b, gap: ev(b, \"poc\").h - m, kevFirst: ev(b, \"kev\").h < ev(b, \"poc\").h }; });\nconst gaps = pocs.map((p) => p.gap), kevFirst = pocs.filter((p) => p.kevFirst).length;\nconst fixes = quiet.map((b) => -ev(b, \"fix\").h);\nconst quietTalkBefore = quiet.filter((b) => b.ev.some((e) => e.k !== \"fix\" && e.h < 0)).length;\nconsole.assert(nBefore === 5 && kevFirst === 4 && quietTalkBefore === 0, \"caption facts changed\");\n\nconst sortRows = (bs) => [...bs].sort((a, b) => Math.min(...a.ev.map((e) => e.h)) - Math.min(...b.ev.map((e) => e.h)));\nconst rowOf = new Map();\nsortRows(loud).forEach((b, i) => rowOf.set(b.cve, i));\nsortRows(quiet).forEach((b, i) => rowOf.set(b.cve, i));\nconst Y = (b) => TOP + rowOf.get(b.cve) * ROW + ROW / 2;\n\n// ---- build the SVG once ----\nconst g = document.getElementById(\"g\");\ng.setAttribute(\"viewBox\", `0 0 ${W} ${H}`);\nlet P = null; // default parent for el(); the timeline's scaffolding goes in chartG\nconst el = (tag, a = {}, p = P || g) => { const e = document.createElementNS(NS, tag); for (const [k, v] of Object.entries(a)) e.setAttribute(k, v); p.appendChild(e); re